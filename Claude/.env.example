# artificial.one automation – copy to .env and fill in values
# Used by Docker/n8n when running the workflow

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Google Sheets
GOOGLE_SHEET_ID=REPLACE_WITH_SPREADSHEET_ID

# Beehiiv
BEEHIIV_API_KEY=REPLACE_WITH_YOUR_KEY
BEEHIIV_PUBLICATION_ID=REPLACE_WITH_YOUR_PUB_ID

# GitHub (optional – for deploy)
GITHUB_TOKEN=REPLACE_WITH_YOUR_TOKEN
GITHUB_REPO=REPLACE_WITH_YOUR_USERNAME/artificial.one

# Site
SITE_URL=https://artificial.one

# Paths (match Docker volume mounts on VPS)
REPO_DIR=/root/n8n/repo
TEMP_CONTENT=/temp-content
APPROVED_CONTENT=/approved-content
SCRIPTS_DIR=/scripts

# Optional – Agent 1 Product Hunt scrape
PRODUCTHUNT_API_KEY=REPLACE_WITH_YOUR_KEY_OR_LEAVE_BLANK
